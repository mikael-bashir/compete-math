{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch: benchmark-report (latexmk -pvc)",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-pvc",
        "-interaction=nonstopmode",
        "-view=none",
        "benchmark-report.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
